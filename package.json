{
  "name": "freereels-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API untuk aplikasi streaming drama (mirror Sansekai API, database-first)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "smoke": "tsx src/scripts/smoke.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.0",
    "@prisma/client": "^8.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.3",
    "pino-pretty": "^13.0.0",
    "undici": "^7.29.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
    "prisma": "^8.0.0",
  }
}
